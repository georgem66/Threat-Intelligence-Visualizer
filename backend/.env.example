# Local development only. Copy to .env and replace both REPLACE_ME values.
# The backend does not load .env automatically; see README for Node --env-file.
NODE_ENV=development
PORT=3001
DB_HOST=localhost
DB_PORT=5432
DB_NAME=threat_intelligence_dev
DB_USERNAME=postgres
DB_PASSWORD=REPLACE_ME
# Generate a unique secret with: openssl rand -hex 32
JWT_SECRET=REPLACE_ME
JWT_EXPIRES_IN=24h
# ERROR, WARN, INFO, or DEBUG (uppercase)
LOG_LEVEL=INFO
